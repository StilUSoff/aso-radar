# Dashboard login (HTTP Basic). Empty password disables auth — only for local use!
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# How often to re-check all keywords, hours (0 = only manual runs)
CHECK_INTERVAL_HOURS=24

# Delay between iTunes Search API calls, seconds (Apple allows ~20/min per IP)
ITUNES_REQUEST_DELAY=3.2

# App Store Connect API key (optional, for importing keywords).
# Put the .p8 file at secrets/AuthKey.p8
ASC_KEY_ID=
ASC_ISSUER_ID=

# Domain for HTTPS via Caddy (docker compose --profile https up -d)
DOMAIN=
# HTTPS port for Caddy; change if 443 is taken (e.g. by a VPN)
HTTPS_PORT=443
APP_PORT=8000
