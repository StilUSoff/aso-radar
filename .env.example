# Dashboard login (HTTP Basic). Empty password disables auth — only for local use!
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Automatic runs (market scan and app positions) on these weekdays at this time.
# Comma-separated: mon,tue,wed,thu,fri,sat,sun. Empty = use the intervals below.
SCHEDULE_WEEKDAYS=fri
SCHEDULE_TIME=00:00
SCHEDULE_TZ=Europe/Moscow

# Without SCHEDULE_WEEKDAYS: re-scan all markets every N hours (0 = only manual).
# A full scan is ~21k requests: ~18 h at the default pace below.
SCAN_INTERVAL_HOURS=24
# Without SCHEDULE_WEEKDAYS: re-check app positions every N hours (0 = only manual)
APP_CHECK_INTERVAL_HOURS=24
# Inner words probed per market to link queries with different first letters
BRIDGE_WORDS=150
# How many top queries to keep per market and scan
TOP_N=500
# Delete scans older than this many days
RETENTION_DAYS=180

# Pace of App Store suggestion requests. Apple blocks an IP for ~40 min after
# roughly 1000-1500 requests in an hour; the scanner then waits it out (Retry-After).
HINTS_PER_HOUR=1200
# Pause between App Store search requests (app positions), seconds; limit ~20/min
SEARCH_REQUEST_DELAY=3.2

# Domain for HTTPS via Caddy (docker compose --profile https up -d)
DOMAIN=
# HTTPS port for Caddy; change if 443 is taken (e.g. by a VPN)
HTTPS_PORT=443
APP_PORT=8000
